<div class="isometric-renderer-app" data-part="renderer">
    <div id="three-container" class="preview-viewport">
        <!-- Three.js Canvas will be injected here -->
    </div>

    <div class="controls">
        <div class="form-group">
            <label>{{localize "3D_TO_ISO.ModelPath"}}</label>
            <div class="form-fields">
                <input type="text" name="modelPath" value="{{modelPath}}" placeholder="path/to/model.glb">
                <button type="button" class="file-picker" data-type="imagevideo" data-target="modelPath" title="{{localize "3D_TO_ISO.Browse"}}">
                    <i class="fas fa-file-import"></i>
                </button>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.OutputPrefix"}}</label>
            <div class="form-fields">
                <input type="text" name="outputPrefix" value="{{outputPrefix}}" placeholder="{{localize '3D_TO_ISO.OutputPrefixPlaceholder'}}">
            </div>
        </div>

        {{#if (or actor document)}}
        <div class="form-group target-actor">
            <label>{{localize "3D_TO_ISO.TargetActor" name=(or actor.name document.name "Target")}}</label>
            <div class="form-fields">
                <button type="button" class="assign-actor-btn primary" title="{{localize '3D_TO_ISO.AssignToActor'}}">
                    <i class="fas fa-check"></i> {{localize "3D_TO_ISO.ProcessAndAssign"}}
                </button>
            </div>
        </div>
        {{/if}}

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.RenderMode"}}</label>
            <div class="form-fields">
                <select name="renderMode">
                    <option value="cardinal" {{#if (eq renderMode "cardinal")}}selected{{/if}}>{{localize "3D_TO_ISO.ModeCardinal"}}</option>
                    <option value="numeric" {{#if (eq renderMode "numeric")}}selected{{/if}}>{{localize "3D_TO_ISO.ModeNumeric"}}</option>
                </select>
            </div>
        </div>

        {{#if (eq renderMode "numeric")}}
        <div class="form-group">
            <label>{{localize "3D_TO_ISO.FrameCount"}}</label>
            <div class="form-fields">
                <input type="number" name="frameCount" value="{{frameCount}}" min="1" max="64" step="1">
                <p class="notes" style="flex-basis: 100%; margin-top: 5px;">{{localize "3D_TO_ISO.FrameCountNotes"}}</p>
            </div>
        </div>
        <div class="form-group">
            <label>{{localize "3D_TO_ISO.PreviewFrame"}}</label>
            <div class="form-fields">
                <input type="number" name="currentFrame" value="{{currentFrame}}" min="0" max="{{frameCount}}" step="1">
            </div>
        </div>
        {{else}}
        <div class="form-group">
            <label>{{localize "3D_TO_ISO.Facing"}}</label>
            <div class="form-fields facings">
                <label><input type="radio" name="facing" value="N" {{#if (eq facing "N")}}checked{{/if}}> {{localize "3D_TO_ISO.N"}}</label>
                <label><input type="radio" name="facing" value="NE" {{#if (eq facing "NE")}}checked{{/if}}> {{localize "3D_TO_ISO.NE"}}</label>
                <label><input type="radio" name="facing" value="E" {{#if (eq facing "E")}}checked{{/if}}> {{localize "3D_TO_ISO.E"}}</label>
                <label><input type="radio" name="facing" value="SE" {{#if (eq facing "SE")}}checked{{/if}}> {{localize "3D_TO_ISO.SE"}}</label>
                <label><input type="radio" name="facing" value="S" {{#if (eq facing "S")}}checked{{/if}}> {{localize "3D_TO_ISO.S"}}</label>
                <label><input type="radio" name="facing" value="SW" {{#if (eq facing "SW")}}checked{{/if}}> {{localize "3D_TO_ISO.SW"}}</label>
                <label><input type="radio" name="facing" value="W" {{#if (eq facing "W")}}checked{{/if}}> {{localize "3D_TO_ISO.W"}}</label>
                <label><input type="radio" name="facing" value="NW" {{#if (eq facing "NW")}}checked{{/if}}> {{localize "3D_TO_ISO.NW"}}</label>
            </div>
        </div>
        {{/if}}

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.Resolution"}}</label>
            <div class="form-fields">
                <select name="resolution">
                    <option value="256" {{#if (eq resolution "256")}}selected{{/if}}>256x256</option>
                    <option value="512" {{#if (eq resolution "512")}}selected{{/if}}>512x512</option>
                    <option value="1024" {{#if (eq resolution "1024")}}selected{{/if}}>1024x1024</option>
                    <option value="2048" {{#if (eq resolution "2048")}}selected{{/if}}>2048x2048</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Ambient Light</label>
            <div class="form-fields">
                <input type="range" name="ambientIntensity" value="{{ambientIntensity}}" min="0" max="2" step="0.05">
                <span class="range-value display-ambientIntensity">{{ambientIntensity}}</span>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.ShaderEffect"}}</label>
            <div class="form-fields">
                <select name="shaderMode">
                    <option value="none" {{#if (eq shaderMode "none")}}selected{{/if}}>{{localize "3D_TO_ISO.ShaderNone"}}</option>
                    <option value="sepia" {{#if (eq shaderMode "sepia")}}selected{{/if}}>{{localize "3D_TO_ISO.ShaderSepia"}}</option>
                    <option value="pixel" {{#if (eq shaderMode "pixel")}}selected{{/if}}>Pixel</option>
                    <option value="sketch" {{#if (eq shaderMode "sketch")}}selected{{/if}}>Sketch</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>Intensity</label>
                <div class="form-fields">
                    <input type="range" name="shaderIntensity" value="{{shaderIntensity}}" min="0" max="1" step="0.05">
                    <span class="range-value display-shaderIntensity">{{shaderIntensity}}</span>
                </div>
            </div>
            <p class="notes">{{localize "3D_TO_ISO.ShaderNote"}}</p>
        </div>

        <hr>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.LinkRotations"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="linkRotations" {{checked linkRotations}}>
                <span class="notes">{{localize "3D_TO_ISO.LinkRotationsHint"}}</span>
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.RotationX"}} ({{displayValues.rx}}°)</label>
            <div class="form-fields">
                <input type="range" name="rx" value="{{adj.rx}}" min="-180" max="180" step="1">
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.RotationY"}} ({{displayValues.ry}}°)</label>
            <div class="form-fields">
                <input type="range" name="ry" value="{{adj.ry}}" min="-180" max="180" step="1">
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.RotationZ"}} ({{displayValues.rz}}°)</label>
            <div class="form-fields">
                <input type="range" name="rz" value="{{adj.rz}}" min="-180" max="180" step="1">
            </div>
        </div>

        <div class="form-group">
            <label>{{localize "3D_TO_ISO.Zoom"}} ({{displayValues.zoom}}x)</label>
            <div class="form-fields">
                <input type="range" name="zoom" value="{{adj.zoom}}" min="0.1" max="5" step="0.1">
            </div>
        </div>

        <div class="form-group reset-buttons">
            <button type="button" class="reset-current-btn"><i class="fas fa-undo"></i> {{localize "3D_TO_ISO.ResetCurrent"}}</button>
            <button type="button" class="reset-all-btn"><i class="fas fa-trash-restore"></i> {{localize "3D_TO_ISO.ResetAll"}}</button>
        </div>

        <footer class="sheet-footer">
            <button type="button" class="render-btn">
                <i class="fas fa-camera"></i> {{localize "3D_TO_ISO.RenderAndSave"}}
            </button>
            <button type="button" class="render-all-btn">
                <i class="fas fa-images"></i> {{localize "3D_TO_ISO.RenderAll"}}
            </button>
        </footer>
    </div>
</div>
